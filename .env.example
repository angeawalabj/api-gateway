# API Gateway — variables d'environnement
# Copier en .env et adapter

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_ADDR=:8080
METRICS_ADDR=:9090
LOG_LEVEL=info
DEV_MODE=true    # désactive JWT en dev local

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DSN=postgres://gwuser:gwpass@localhost:5432/gateway?sslmode=disable

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT (production) ─────────────────────────────────────────────────────────
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=api-gateway

# ── Terraform ────────────────────────────────────────────────────────────────
# AWS_REGION=eu-west-1
# S3_BUCKET=mon-bucket-gateway
# EC2_KEY_NAME=ma-keypair
